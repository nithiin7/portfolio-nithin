{
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "always"
	},
	"eslint.validate": [
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact"
	],
	"editor.formatOnSave": true,
	"eslint.probe": [
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact"
	],
	"cSpell.words": [
		"eslintcache",
		"nuxt",
		"Supabase",
		"Vercel"
	]
}
