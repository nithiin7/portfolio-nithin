# Copy to .env for local development. Never commit real values.
# Required = the server refuses to start without it (src/helpers/env.ts).

# ── Contentful (required) ───────────────────────────────────────────────────
# Settings → API keys → a Delivery API key (read-only, published content)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_VERSION=v1
CONTENTFUL_ACCESS_TOKEN=
# Shared secret the Contentful webhook sends to /api/revalidate
CONTENTFUL_REVALIDATE_SECRET=
# "true" reads drafts through the Preview API; needs the preview token below
CONTENTFUL_PREVIEW=
CONTENTFUL_PREVIEW_ACCESS_TOKEN=
# Local scripts only (pnpm cms:*). Never set this on Vercel.
CONTENTFUL_MANAGEMENT_TOKEN=

# ── Supabase: comments, blog views, newsletter ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── reCAPTCHA v3: contact form, comments, AI search ─────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Unset locally: comments fail verification and /api/ask skips the check
RECAPTCHA_SECRET_KEY=

# ── EmailJS: contact form ───────────────────────────────────────────────────
NEXT_PUBLIC_SERVICE_ID=
NEXT_PUBLIC_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_ID=

# ── Optional features ───────────────────────────────────────────────────────
# Google Tag Manager container; unset = no analytics
NEXT_PUBLIC_GOOGLE_GTM_ID=
# Command palette "Ask AI" and pnpm embed; unset = /api/ask answers 503
OPENAI_API_KEY=
# /stats coding-activity card; unset = card hidden
WAKATIME_API_KEY=
# /stats Hugging Face card for the private chat Space; unset = card hidden
HUGGINGFACE_TOKEN=
