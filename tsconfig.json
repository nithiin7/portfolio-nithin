{
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"incremental": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"baseUrl": "./src/",
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"paths": {
		"@assets/*": ["assets/*"],
		"@components/*": ["components/*"],
		"@helpers/*": ["helpers/*"],
		"@queries/*": ["queries/*"],
		"@styles/*": ["styles/*"],
		"@utils/*": ["utils/*"]
	},
	"include": [
		"next-env.d.ts",
		".next/types/**/*.ts",
		"**/*.ts",
		"**/*.tsx",
		"src/**/*"
	],
	"exclude": ["node_modules"]
}
