{
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"incremental": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"plugins": [
			{
				"name": "next"
			}
		],
		"target": "ES2017",
		"paths": {
			"app/*": ["./src/app/*"],
			"assets/*": ["./src/assets/*"],
			"clients/*": ["./src/clients/*"],
			"components/*": ["./src/components/*"],
			"config/*": ["./src/config/*"],
			"constants/*": ["./src/constants/*"],
			"contexts/*": ["./src/contexts/*"],
			"helpers/*": ["./src/helpers/*"],
			"hooks/*": ["./src/hooks/*"],
			"queries/*": ["./src/queries/*"],
			"services/*": ["./src/services/*"],
			"styles/*": ["./src/styles/*"],
			"test/*": ["./src/test/*"],
			"types/*": ["./src/types/*"],
			"data/*": ["./data/*"]
		},
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true
	},
	"include": [
		"next-env.d.ts",
		".next/types/**/*.ts",
		"**/*.ts",
		"**/*.tsx",
		"**/*.js",
		"**/*.jsx",
		"**/*.json",
		"**/*.mjs",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
