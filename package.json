{
	"name": "portfolio-nithin",
	"version": "4.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"eslint": "eslint .",
		"eslint:fix": "eslint --fix .",
		"prettier": "prettier --check \"**/*.+(js|jsx|ts|tsx|json|yml|yaml|md|css)\"",
		"prettier:fix": "prettier --write \"**/*.+(js|jsx|ts|tsx|json|yml|yaml|md|css)\"",
		"prepare": "husky",
		"pre-commit": "lint-staged",
		"generate": "plop",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"release": "standard-version",
		"release:minor": "standard-version --release-as minor",
		"release:patch": "standard-version --release-as patch",
		"release:major": "standard-version --release-as major"
	},
	"dependencies": {
		"@apollo/client": "^3.13.9",
		"@contentful/rich-text-react-renderer": "^15.19.0",
		"@hookform/resolvers": "^3.3.2",
		"@next/third-parties": "^16.2.9",
		"@sentry/nextjs": "^10.57.0",
		"@studio-freight/react-lenis": "^0.0.43",
		"@supabase/supabase-js": "^2.54.0",
		"@svgr/webpack": "^8.1.0",
		"contentful": "^11.7.15",
		"deepmerge": "^4.3.1",
		"emailjs-com": "^3.2.0",
		"eslint-plugin-unused-imports": "^4.1.4",
		"graphql": "^16.11.0",
		"gsap": "^3.13.0",
		"loadash": "^1.0.0",
		"motion": "^12.40.0",
		"next": "^16.2.9",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-google-recaptcha-v3": "^1.11.0",
		"react-gtm-module": "^2.0.11",
		"react-hook-form": "^7.62.0",
		"react-icons": "^4.12.0",
		"react-intersection-observer": "^9.16.0",
		"react-scroll": "^1.9.3",
		"sass": "^1.90.0",
		"sharp": "^0.34.3",
		"sonner": "^2.0.7",
		"yup": "^1.7.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/compat": "^1.3.2",
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.32.0",
		"@next/eslint-plugin-next": "^16.2.9",
		"@storybook/addon-docs": "^9.1.1",
		"@storybook/addon-links": "^9.1.1",
		"@storybook/addon-onboarding": "^9.1.1",
		"@storybook/addon-styling-webpack": "^0.0.6",
		"@storybook/nextjs": "^9.1.1",
		"@types/lodash": "^4.17.20",
		"@types/node": "^24.2.0",
		"@types/react": "^19.1.9",
		"@types/react-dom": "^19.1.7",
		"@types/react-gtm-module": "^2.0.4",
		"@types/react-scroll": "^1.8.10",
		"eslint": "^9.32.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-storybook": "9.1.1",
		"globals": "^16.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.4",
		"plop": "^3.1.2",
		"prettier": "^3.6.2",
		"standard-version": "^9.5.0",
		"storybook": "^9.1.1",
		"storybook-addon-sass-postcss": "^0.1.3",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	},
	"lint-staged": {
		"./*/**/*.{js,jsx,ts,tsx}": [
			"npm run prettier:fix",
			"npm run eslint:fix"
		],
		"*.{json,md}": [
			"npm run prettier:fix"
		]
	},
	"resolutions": {
		"@types/react": "19.0.10"
	}
}
