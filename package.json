{
	"name": "portfolio-nithin",
	"version": "4.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.0.5",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"analyze": "ANALYZE=true next build --webpack",
		"analyze:turbopack": "next build --experimental-analyze",
		"start": "next start",
		"lint": "eslint .",
		"eslint": "eslint .",
		"eslint:fix": "eslint --fix .",
		"prettier": "prettier --check \"**/*.+(js|jsx|ts|tsx|json|yml|yaml|md|css)\"",
		"prettier:fix": "prettier --write \"**/*.+(js|jsx|ts|tsx|json|yml|yaml|md|css)\"",
		"prepare": "husky",
		"pre-commit": "lint-staged",
		"generate": "plop",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"release": "standard-version",
		"release:minor": "standard-version --release-as minor",
		"release:patch": "standard-version --release-as patch",
		"release:major": "standard-version --release-as major"
	},
	"dependencies": {
		"@apollo/client": "^4.2.7",
		"@contentful/rich-text-react-renderer": "^15.22.11",
		"@contentful/rich-text-types": "^17.2.7",
		"@emailjs/browser": "^4.4.1",
		"@hookform/resolvers": "^3.10.0",
		"@next/third-parties": "^16.2.10",
		"@sentry/nextjs": "^10.66.0",
		"@supabase/supabase-js": "^2.110.7",
		"@svgr/webpack": "^8.1.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"contentful": "^11.12.7",
		"eslint-plugin-unused-imports": "^4.4.1",
		"graphql": "^16.14.2",
		"gsap": "^3.15.0",
		"lenis": "^1.3.25",
		"motion": "^12.42.2",
		"next": "^16.2.10",
		"nuqs": "^2.9.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-google-recaptcha-v3": "^1.11.0",
		"react-gtm-module": "^2.0.11",
		"react-hook-form": "^7.82.0",
		"react-icons": "^5.7.0",
		"react-intersection-observer": "^9.16.0",
		"react-scroll": "^1.9.3",
		"rxjs": "^7.8.2",
		"sass": "^1.101.0",
		"server-only": "^0.0.1",
		"sharp": "^0.34.5",
		"sonner": "^2.0.7",
		"yup": "^1.7.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@commitlint/types": "^21.2.0",
		"@eslint/compat": "^1.4.1",
		"@eslint/eslintrc": "^3.3.6",
		"@eslint/js": "^9.39.5",
		"@next/bundle-analyzer": "^16.2.10",
		"@next/eslint-plugin-next": "^16.2.10",
		"@playwright/test": "^1.61.1",
		"@storybook/addon-docs": "^9.1.20",
		"@storybook/addon-links": "^9.1.20",
		"@storybook/addon-onboarding": "^9.1.20",
		"@storybook/addon-styling-webpack": "^0.0.6",
		"@storybook/nextjs": "^9.1.20",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/react-gtm-module": "^2.0.4",
		"@types/react-scroll": "^1.8.10",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-storybook": "9.1.1",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"plop": "^3.1.2",
		"prettier": "^3.9.5",
		"standard-version": "^9.5.0",
		"storybook": "^9.1.20",
		"storybook-addon-sass-postcss": "^0.1.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.64.0",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"./*/**/*.{js,jsx,ts,tsx}": [
			"pnpm run prettier:fix",
			"pnpm run eslint:fix"
		],
		"*.{json,md}": [
			"pnpm run prettier:fix"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"@sentry/cli",
			"core-js",
			"core-js-pure",
			"esbuild",
			"sharp",
			"unrs-resolver"
		]
	}
}
