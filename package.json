{
	"name": "portfolio-nithin",
	"version": "4.0.1",
	"description": "Portfolio of Nithin Pradeep, AI and full-stack engineer: editorial Swiss design, Contentful case studies, a blog, live stats and a RAG assistant. Next.js 16, React 19, TypeScript.",
	"keywords": [
		"portfolio",
		"nextjs",
		"react",
		"typescript",
		"contentful",
		"supabase",
		"motion",
		"scss",
		"rag",
		"awwwards"
	],
	"homepage": "https://portfolio-nithin.vercel.app",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nithiin7/portfolio-nithin.git"
	},
	"bugs": {
		"url": "https://github.com/nithiin7/portfolio-nithin/issues"
	},
	"author": "Nithin Pradeep (https://portfolio-nithin.vercel.app)",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.0.5",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"analyze": "ANALYZE=true next build --webpack",
		"analyze:turbopack": "next build --experimental-analyze",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"format": "prettier --check \"**/*.+(js|jsx|ts|tsx|mjs|json|yml|yaml|md|css|scss)\"",
		"format:fix": "prettier --write \"**/*.+(js|jsx|ts|tsx|mjs|json|yml|yaml|md|css|scss)\"",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"prepare": "husky",
		"generate": "plop",
		"embed": "node --env-file-if-exists=.env scripts/embed.ts",
		"embed:check": "node scripts/embed.ts --check",
		"icons": "node scripts/icons.ts",
		"plates": "node scripts/plates/index.ts",
		"plates:capture": "node scripts/plates/capture.ts",
		"plates:compose": "node scripts/plates/compose.ts",
		"plates:blog": "node scripts/plates/blog.ts",
		"plates:blog:upload": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/plates/blog-upload.ts",
		"plates:upload": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/plates/upload.ts",
		"cms:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local contentful/migrate.ts",
		"cms:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local contentful/check.ts",
		"cms:publish": "node --env-file-if-exists=.env --env-file-if-exists=.env.local contentful/publish.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@apollo/client": "^4.3.8",
		"@contentful/rich-text-react-renderer": "^15.22.11",
		"@contentful/rich-text-types": "^17.2.7",
		"@emailjs/browser": "^4.4.1",
		"@hookform/resolvers": "^3.10.0",
		"@sentry/nextjs": "^10.78.0",
		"@supabase/supabase-js": "^2.119.0",
		"@svgr/webpack": "^8.1.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.1.0",
		"graphql": "^16.15.0",
		"lenis": "^1.3.27",
		"motion": "^12.43.0",
		"next": "^16.4.6",
		"nuqs": "^2.10.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-google-recaptcha-v3": "^1.11.0",
		"react-hook-form": "^7.91.0",
		"react-intersection-observer": "^9.16.0",
		"sass": "^1.108.1",
		"server-only": "^0.0.1",
		"sharp": "^0.35.5",
		"sonner": "^2.0.8",
		"yup": "^1.7.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@commitlint/types": "^21.2.3",
		"@eslint/js": "^9.39.5",
		"@next/bundle-analyzer": "^16.4.6",
		"@next/eslint-plugin-next": "^16.4.6",
		"@playwright/test": "^1.65.0",
		"@serwist/turbopack": "^9.5.13",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.9",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "4.1.12",
		"contentful-migration": "^5.1.1",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"knip": "^5.88.1",
		"lint-staged": "^16.4.0",
		"plop": "^3.1.2",
		"prettier": "^3.9.10",
		"serwist": "^9.5.13",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^4.1.12"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml,yaml,css,scss}": [
			"prettier --write"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"@sentry/cli",
			"core-js",
			"core-js-pure",
			"esbuild",
			"sharp",
			"unrs-resolver"
		]
	}
}
